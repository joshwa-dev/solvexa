# ============================================
# SOLVEXA ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate with your credentials
# NEVER commit .env.local or any secrets to Git
# ============================================

# Firebase Web App Credentials (Firebase Spark / Free Plan)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary Unsigned Media Uploads (Free Plan)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Emulator Suite (Optional - Set to true for local testing)
VITE_USE_EMULATOR=false
